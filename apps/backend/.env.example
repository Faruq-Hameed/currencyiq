NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# --- Database (Postgres) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=currencyiq
DB_USER=postgres
DB_PASS=secret
# Set to "true" for hosted Postgres that requires SSL (Neon, Supabase, RDS, etc.)
DB_SSL=false

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Set to "true" if connecting over TLS (e.g. Upstash's rediss:// host/port pair)
REDIS_TLS=false
# Alternative: a single connection string (e.g. Upstash "ioredis"/Redis URL). Takes
# precedence over REDIS_HOST/PORT/PASSWORD/TLS above when set. Use a rediss:// URL for TLS.
REDIS_URL=

JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Exchange rate providers ---
OPEN_EXCHANGE_APP_ID=
EXCHANGERATE_API_KEY=
CURRENCYFREAKS_API_KEY=

# --- Currency metadata (name/symbol/flag/country list seeding) ---
RESTCOUNTRIES_API_KEY=

# --- SMTP (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@currencyiq.dev

# --- Vercel only: shared secret Vercel Cron sends as `Authorization: Bearer <value>` ---
# when calling /api/v1/internal/cron/* to trigger the scheduled jobs (rate sync, quota
# reset, etc). Not needed for Docker/local dev, where @nestjs/schedule runs them in-process.
CRON_SECRET=
